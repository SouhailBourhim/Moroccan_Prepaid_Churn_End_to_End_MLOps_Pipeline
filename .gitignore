# Python
__pycache__/
*.py[cod]
*.so
.Python
dist/
build/
*.egg-info/
.eggs/
*.egg

# Environments
.env
.venv/
venv/
env/

# Data – track via DVC, not git
# data/raw/ is intentionally NOT listed: DVC writes per-directory .gitignore
# files inside it so the .dvc pointer files stay git-tracked.
data/processed/
data/features/
data/interim/
*.parquet
*.feather
!data/.gitkeep

# MLflow
mlruns/
mlruns.db
mlartifacts/

# Prediction log (SQLite — local dev artifact, not committed)
data/predictions.db
data/predictions.db-shm
data/predictions.db-wal

# Notebooks – strip outputs before commit
notebooks/.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp
.DS_Store

# Docker
.docker/

# DVC
/tmp

# Test / Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node (dashboard)
dashboard/node_modules/
dashboard/.next/
dashboard/build/
