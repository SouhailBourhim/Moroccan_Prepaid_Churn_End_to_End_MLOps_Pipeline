# Copy to .env and fill in values before running the API in production.
# Never commit .env — it is gitignored.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for X-API-Key header.
# When unset the API runs in open dev mode (no auth enforced).
CHURN_API_KEYS=your-secret-key-here

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per 60-second sliding window per client IP.
# Defaults apply when these are unset.
CHURN_RATE_LIMIT_GENERAL=200
CHURN_RATE_LIMIT_PREDICT=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to "json" for structured JSON output (Datadog, CloudWatch, etc.).
# Unset for human-readable coloured text (default).
# LOG_FORMAT=json
