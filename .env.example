# Copy to .env and fill in values before running the API.
# Never commit .env — it is gitignored. docker compose reads it automatically.

# ── Serving ───────────────────────────────────────────────────────────────────
# Which dataset's model to serve: expresso | moroccan
CHURN_DATASET=expresso

# ── Auth ──────────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys for the X-API-Key header.
# Auth fails closed: with no keys set, protected endpoints return 503.
CHURN_API_KEYS=your-secret-key-here
# Local development only — turns API key auth off entirely.
# CHURN_AUTH_DISABLED=1

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per 60-second sliding window per client, across all workers.
CHURN_RATE_LIMIT_GENERAL=200
CHURN_RATE_LIMIT_PREDICT=30
# IPs of reverse proxies allowed to set X-Forwarded-For. Leave empty when the
# API is exposed directly; otherwise clients could spoof their identity.
CHURN_TRUSTED_PROXIES=
API_WORKERS=4

# ── Prediction log ────────────────────────────────────────────────────────────
# CHURN_PREDICTIONS_DB=data/predictions.db
CHURN_LOG_RETENTION_DAYS=30

# ── Logging ───────────────────────────────────────────────────────────────────
# Set to "json" for structured JSON output (Datadog, CloudWatch, etc.).
# Unset for human-readable coloured text (default).
# LOG_FORMAT=json

# ── Dashboard (dashboard/.env.local) ──────────────────────────────────────────
# VITE_CHURN_API_URL=http://localhost:8000
# VITE_CHURN_API_KEY=your-secret-key-here   # baked into the JS bundle: local/internal use only
